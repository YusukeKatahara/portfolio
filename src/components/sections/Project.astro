---
import Screen from '../Screen.astro';
import TavnsWhy from '../visuals/TavnsWhy.astro';
import TavnsRig from '../visuals/TavnsRig.astro';
import TavnsPanel from '../visuals/TavnsPanel.astro';
import VeffectApp from '../visuals/VeffectApp.astro';
import VeffectGrowth from '../visuals/VeffectGrowth.astro';
import type { Project } from '../../data/types';

interface Props { project: Project }
const { project } = Astro.props;

const VISUALS = {
  'tavns-why': TavnsWhy,
  'tavns-rig': TavnsRig,
  'tavns-panel': TavnsPanel,
  'veffect-app': VeffectApp,
  'veffect-growth': VeffectGrowth,
};

/** 図の帯の列幅。weight の比で分ける */
const cols = project.plates.map((p) => `minmax(0, ${p.weight ?? 1}fr)`).join(' ');

/** 本文中の {key} をリンクに置換して、文字列とリンクの配列に分解する */
function splitLinks(text: string) {
  const parts: ({ t: 'text'; v: string } | { t: 'link'; label: string; url: string })[] = [];
  const re = /\{(\w+)\}/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(text))) {
    if (m.index > last) parts.push({ t: 'text', v: text.slice(last, m.index) });
    const link = project.links?.find((l) => l.key === m![1]);
    if (link) parts.push({ t: 'link', label: link.label, url: link.url });
    else parts.push({ t: 'text', v: m[0] });
    last = m.index + m[0].length;
  }
  if (last < text.length) parts.push({ t: 'text', v: text.slice(last) });
  return parts;
}
---

<Screen id={project.id} group="projects" class="screen--project" labelledby={`${project.id}-title`}>
  <h2 class="project-title" id={`${project.id}-title`}>
    <span class="project-name">{project.name}</span>
    <span class="project-tagline">– {project.tagline}</span>
  </h2>

  <div class="project-body">
    <div class="project-text">
      <div>
        <h3 class="h3">Overview</h3>
        {project.overview.map((p) => (
          <p class="body">
            {splitLinks(p).map((part) =>
              part.t === 'text' ? part.v : <a href={part.url} target="_blank" rel="noopener">{part.label}</a>
            )}
          </p>
        ))}
      </div>
      <div>
        <h3 class="h3">MY ROLE</h3>
        {project.role.map((p) => <p class="body">{p}</p>)}
      </div>
    </div>

    <div class="project-plates" style={`--cols:${cols}`}>
      {project.plates.map((plate) => {
        const Visual = VISUALS[plate.visual];
        return (
          <div class="plate">
            <Visual />
            <p class="plate-title">{plate.title}</p>
            <p class="plate-caption">{plate.caption}</p>
          </div>
        );
      })}
    </div>
  </div>

  {project.footnote && <p class="project-footnote body">{project.footnote}</p>}
</Screen>
