---
import { getCollection } from 'astro:content';
import type { Lang } from '../../i18n/ui';
import { useTranslations, localizePath } from '../../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (await getCollection('blog', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmt = new Intl.DateTimeFormat(lang === 'ja' ? 'ja-JP' : 'en-US', { dateStyle: 'medium' });
---

<h1 class="page-title">{t('blog.title')}</h1>
<p class="page-lead">{t('blog.lead')}</p>

{posts.length === 0 ? (
  <div class="empty-state">
    {/* 丸くなって眠る犬の影絵 */}
    <svg width="180" height="110" viewBox="0 0 180 110" aria-hidden="true">
      <path
        fill="#171512"
        d="M30 88 C18 80 14 62 24 48 C34 32 58 24 82 26 C110 28 132 40 140 58 C146 74 138 86 122 90 C96 97 50 99 30 88 Z"
      />
      <path fill="#171512" d="M124 62 C136 56 148 58 152 66 C155 74 148 82 136 82 C126 82 118 76 118 70 Z" />
      <path fill="#171512" d="M140 56 C142 50 148 48 152 52 C154 56 152 60 146 61 Z" />
      <path fill="#171512" d="M28 78 C14 74 8 64 14 54 C18 48 26 46 32 50 C24 58 24 70 28 78 Z" />
      <text x="150" y="34" font-family="var(--font-display)" font-size="16" font-weight="700" fill="#8a8376">z</text>
      <text x="160" y="22" font-family="var(--font-display)" font-size="12" font-weight="700" fill="#8a8376">z</text>
      <text x="168" y="13" font-family="var(--font-display)" font-size="9" font-weight="700" fill="#8a8376">z</text>
    </svg>
    <p class="big">{t('blog.empty')}</p>
    <p class="note">{t('blog.emptyNote')}</p>
  </div>
) : (
  <ul class="post-list">
    {posts.map((post) => {
      const slug = post.id.replace(`${lang}/`, '');
      return (
        <li>
          <a class="card" href={localizePath(`/blog/${slug}`, lang)}>
            <div class="card-head">
              <h3>{post.data.title}</h3>
              <span class="badge badge-tbd">{fmt.format(post.data.date)}</span>
            </div>
            {post.data.summary && <p>{post.data.summary}</p>}
          </a>
        </li>
      );
    })}
  </ul>
)}
