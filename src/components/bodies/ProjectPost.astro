---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../../i18n/ui';
import { useTranslations, localizePath } from '../../i18n/utils';

interface Props { lang: Lang; entry: CollectionEntry<'projects'> }
const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
---

<header class="project-header">
  <div class="card-head">
    <h1 class="page-title" style="margin-bottom:0">{entry.data.title}</h1>
    <span class={`badge badge-${entry.data.status}`}>{t(`projects.status.${entry.data.status}`)}</span>
  </div>
  <p class="page-lead" style="margin-bottom:0">{entry.data.summary}</p>
</header>

{entry.data.links.length > 0 && (
  <div class="link-buttons">
    {entry.data.links.map((l) => (
      <a class="btn" href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>
    ))}
  </div>
)}

<div class="prose">
  <Content />
</div>

<a class="back-link" href={localizePath('/projects', lang)}>← {t('projects.back')}</a>
