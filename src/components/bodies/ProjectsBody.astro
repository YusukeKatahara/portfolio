---
import { getCollection } from 'astro:content';
import type { Lang } from '../../i18n/ui';
import { useTranslations, localizePath } from '../../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getCollection('projects', (e) => e.id.startsWith(`${lang}/`)))
  .sort((a, b) => a.data.order - b.data.order);
---

<h1 class="page-title">{t('projects.title')}</h1>
<p class="page-lead">{t('projects.lead')}</p>

<div class="cards">
  {projects.map((p) => {
    const slug = p.id.replace(`${lang}/`, '');
    return (
      <a class="card" href={localizePath(`/projects/${slug}`, lang)}>
        <div class="card-head">
          <h3>{p.data.title}</h3>
          <span class={`badge badge-${p.data.status}`}>{t(`projects.status.${p.data.status}`)}</span>
        </div>
        <p>{p.data.summary}</p>
        {p.data.tags.length > 0 && <div class="tags">{p.data.tags.map((tag) => <span>{tag}</span>)}</div>}
      </a>
    );
  })}
</div>
