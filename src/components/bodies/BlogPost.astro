---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../../i18n/ui';
import { useTranslations, localizePath } from '../../i18n/utils';

interface Props { lang: Lang; entry: CollectionEntry<'blog'> }
const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat(lang === 'ja' ? 'ja-JP' : 'en-US', { dateStyle: 'long' });
---

<header class="project-header">
  <h1 class="page-title" style="margin-bottom:0.2em">{entry.data.title}</h1>
  <p class="section-note" style="margin:0">{fmt.format(entry.data.date)}</p>
</header>

<div class="prose">
  <Content />
</div>

<a class="back-link" href={localizePath('/blog', lang)}>← {t('blog.title')}</a>
