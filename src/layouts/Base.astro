---
import '../styles/global.css';
import { en } from '../data/copy.en';

interface Props {
  title?: string;
  description?: string;
}

const copy = en;
const title = Astro.props.title ? `${Astro.props.title} | bigdogdig.com` : copy.meta.title;
const description = Astro.props.description ?? copy.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {/* Impact はローカルフォント（Windows/macOS）。無い端末向けに最も近い Anton を配信する */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&display=swap" />
  </head>
  <body>
    <a class="skip" href="#main">{copy.a11y.skip}</a>
    <slot />
    <script src="../scripts/main.ts"></script>
  </body>
</html>
