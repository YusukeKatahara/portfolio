---
import Screen from '../Screen.astro';
import Tabs from '../Tabs.astro';
import CareerTimeline from '../CareerTimeline.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Copy } from '../../data/types';

interface Props { copy: Copy['who'] }
const { copy } = Astro.props;
const tabs = [
  { id: 'career', label: copy.tabs.career },
  { id: 'style', label: copy.tabs.style },
  { id: 'hobbies', label: copy.tabs.hobbies },
];

/**
 * ポートレート差し込み口。
 * src/assets/portrait.jpg（.png / .webp でも可）を置けば自動で写真表示に切り替わる。
 * 無い間は「YK」のモノグラムパネル（DIG · BUILD · TEST の帯付き）が描画される。
 */
const portraitFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/portrait.{jpg,jpeg,png,webp}', {
  eager: true,
});
const portrait = Object.values(portraitFiles)[0]?.default;
---

<Screen id="who-i-am" group="about" class="screen--who" labelledby="who-title">
  <div class="who-head">
    <div class="who-head-text">
      <h2 class="who-name" id="who-title">{copy.name}</h2>

      <ul class="triad" aria-label="Roles">
        {copy.triad.map((t) => (
          <li>
            <span class="triad-verb">{t.verb}</span>
            <span class="triad-noun">{t.noun}</span>
          </li>
        ))}
      </ul>
    </div>

    <figure class="portrait">
      {portrait ? (
        <Image
          class="portrait-img"
          src={portrait}
          alt="Portrait of Yusuke Katahara"
          widths={[320, 480, 640]}
          sizes="(max-width: 900px) 60vw, 16rem"
        />
      ) : (
        <div class="portrait-mono" role="img" aria-label="Monogram of Yusuke Katahara — DIG, BUILD, TEST">
          <span class="portrait-dot" aria-hidden="true"></span>
          <span class="portrait-initials" aria-hidden="true">YK</span>
          <span class="portrait-strip" aria-hidden="true">DIG · BUILD · TEST</span>
        </div>
      )}
    </figure>
  </div>

  <Tabs name="who" tabs={tabs} initial="career" barClass="tab-bar--big tab-bar--spread">
    <div slot="career">
      <CareerTimeline points={copy.career} />
    </div>

    <div slot="style" class="style-panel">
      <p class="style-lead">{copy.style.lead}</p>
      <ul class="style-list">
        {copy.style.points.map((p) => (
          <li>
            <b class="style-title">{p.title}</b>
            <span class="style-body">{p.body}</span>
          </li>
        ))}
      </ul>
    </div>

    <div slot="hobbies" class="hobbies-panel">
      <ul class="hobby-list">
        {copy.hobbies.map((h) => (
          <li>
            <b class="hobby-label">{h.label}</b>
            {h.note && <span class="hobby-note">{h.note}</span>}
          </li>
        ))}
      </ul>
    </div>
  </Tabs>
</Screen>
