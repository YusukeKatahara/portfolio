---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogPost from '../../components/bodies/BlogPost.astro';

export async function getStaticPaths() {
  const entries = await getCollection('blog', (e) => e.id.startsWith('ja/') && !e.data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/^ja\//, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<Base title={entry.data.title} description={entry.data.summary}>
  <BlogPost lang="ja" entry={entry} />
</Base>
