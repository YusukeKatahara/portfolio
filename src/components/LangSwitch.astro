---
import type { Lang } from '../i18n/ui';
import { switchLangPath } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const jaPath = switchLangPath(Astro.url.pathname, 'ja');
const enPath = switchLangPath(Astro.url.pathname, 'en');
---
<nav class="lang-switch" aria-label="Language">
  <a href={jaPath} aria-current={lang === 'ja' ? 'true' : undefined} lang="ja">日本語</a>
  <a href={enPath} aria-current={lang === 'en' ? 'true' : undefined} lang="en">EN</a>
</nav>
