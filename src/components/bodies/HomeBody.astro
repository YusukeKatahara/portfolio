---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { Lang } from '../../i18n/ui';
import { useTranslations, localizePath } from '../../i18n/utils';
import photo from '../../assets/photos/4yo.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getCollection('projects', (e) => e.id.startsWith(`${lang}/`)))
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="hero">
  <div>
    <h1 class="hero-name" translate="no">
      片原 佑介
      <span class="latin">YUSUKE KATAHARA</span>
    </h1>
    <p class="hero-role">{t('home.role')}</p>
    <p class="hero-summary">{t('home.summary')}</p>
    <p class="hero-note"><b>BIG DOG DIG</b> — {t('home.nameNote')}</p>
  </div>
  <figure class="polaroid hero-photo">
    <Image src={photo} alt={lang === 'ja' ? '片原佑介のプロフィール写真' : 'Profile photo of Yusuke Katahara'} width={460} densities={[1, 2]} />
    <figcaption>{t('home.photoCaption')}</figcaption>
  </figure>
</section>

<section class="section">
  <h2 class="section-title">{t('home.highlights')}<span class="sub">Projects</span></h2>
  <div class="cards">
    {projects.map((p) => {
      const slug = p.id.replace(`${lang}/`, '');
      return (
        <a class="card" href={localizePath(`/projects/${slug}`, lang)}>
          <div class="card-head">
            <h3>{p.data.title}</h3>
            <span class={`badge badge-${p.data.status}`}>{t(`projects.status.${p.data.status}`)}</span>
          </div>
          <p>{p.data.summary}</p>
        </a>
      );
    })}
  </div>
  <a class="more-link" href={localizePath('/projects', lang)}>{t('home.viewAll')} →</a>
</section>
