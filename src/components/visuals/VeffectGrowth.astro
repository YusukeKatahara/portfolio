---
import Figure from './_Figure.astro';
interface Props { class?: string }
const { class: cls } = Astro.props;
---

<Figure
  kind="veffect"
  class={cls}
  viewBox="0 0 1280 720"
  title="Bars rising ever more steeply: one small win compounds into the next. The winner effect."
>
  <text x="64" y="150" font-size="76">WINNER</text>
  <text x="64" y="228" font-size="76">EFFECT</text>

  <rect x="60" y="636" width="1160" height="10" />
  <g class="v-bars">
    <rect x="90" y="546" width="120" height="90" />
    <rect x="290" y="481" width="120" height="155" />
    <rect x="490" y="386" width="120" height="250" />
    <rect x="690" y="251" width="120" height="385" />
    <rect x="890" y="91" width="120" height="545" />
  </g>

  <polyline class="v-trend" points="150,546 350,481 550,386 750,251 950,91" fill="none" stroke="currentColor" stroke-width="14" />
  <g class="v-nodes">
    <circle cx="150" cy="546" r="22" /><circle cx="350" cy="481" r="22" />
    <circle cx="550" cy="386" r="22" /><circle cx="750" cy="251" r="22" />
  </g>
  <circle class="ac v-peak" cx="950" cy="91" r="32" />

  <text x="90" y="700" font-size="46">A SMALL WIN</text>
  <text x="1220" y="700" font-size="46" text-anchor="end">COMPOUNDS INTO THE NEXT</text>
</Figure>
