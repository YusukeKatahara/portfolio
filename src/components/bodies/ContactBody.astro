---
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { WEB3FORMS_ACCESS_KEY, SOCIAL } from '../../site.config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const formReady = !WEB3FORMS_ACCESS_KEY.startsWith('REPLACE');
---

<h1 class="page-title">{t('contact.title')}</h1>
<p class="page-lead">{t('contact.lead')}</p>

<section class="section">
  {formReady ? (
    <form
      id="contact-form"
      class="contact-form"
      data-sending-msg={t('contact.form.sending')}
      data-done-msg={t('contact.form.done')}
      data-error-msg={t('contact.form.error')}
    >
      <label>
        {t('contact.form.name')}
        <input type="text" name="name" required autocomplete="name" />
      </label>
      <label>
        {t('contact.form.email')}
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label>
        {t('contact.form.message')}
        <textarea name="message" rows="6" required></textarea>
      </label>
      {/* honeypot: 人間には見えない。botが埋めると弾かれる */}
      <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />
      <button class="btn" type="submit">{t('contact.form.send')}</button>
      <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
    </form>
  ) : (
    <p class="form-note">{t('contact.form.preparing')}</p>
  )}
</section>

<section class="section">
  <h2 class="section-title">{t('contact.links')}<span class="sub">Links</span></h2>
  <ul class="contact-links">
    <li>
      <a href={SOCIAL.linkedin} target="_blank" rel="noopener">
        LinkedIn <span class="dom">linkedin.com/in/yusuke-katahara</span>
      </a>
    </li>
    <li>
      <a href={SOCIAL.github} target="_blank" rel="noopener">
        GitHub <span class="dom">github.com/YusukeKatahara</span>
      </a>
    </li>
  </ul>
</section>
