---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Stage from '../components/Stage.astro';
import NavTiles from '../components/NavTiles.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { getLangFromUrl, useTranslations, switchLangPath, localizePath } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const title = Astro.props.title ? `${Astro.props.title} | bigdogdig.com` : t('site.title');
const description = Astro.props.description ?? t('site.desc');
const canonical = new URL(Astro.url.pathname, Astro.site);
const altJa = new URL(switchLangPath(Astro.url.pathname, 'ja'), Astro.site);
const altEn = new URL(switchLangPath(Astro.url.pathname, 'en'), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#faf6ef" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ja" href={altJa} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altJa} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700&family=Zen+Old+Mincho:wght@700;900&display=swap"
    />
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">{t('a11y.skip')}</a>
    <header class="den">
      <Stage />
      <a class="wordmark" href={localizePath('/', lang)} data-dig>bigdogdig.com</a>
      <LangSwitch lang={lang} />
      <div class="ground" aria-hidden="true"></div>
      <NavTiles lang={lang} />
    </header>
    <main id="main" transition:name="main-content">
      <slot />
    </main>
    <footer class="foot">{t('footer.copyright')}</footer>
    <script src="../scripts/den.ts"></script>
  </body>
</html>
