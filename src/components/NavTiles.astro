---
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'ja' ? 'en' : 'ja';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';

const items = (['about', 'projects', 'blog', 'contact'] as const).map((key) => ({
  href: localizePath(`/${key}`, lang),
  main: t(`nav.${key}`),
  sub: lang === 'ja' ? ui.en[`nav.${key}`] : ui.ja[`nav.${key}`],
}));

function isActive(href: string): boolean {
  const clean = href.replace(/\/$/, '');
  return current === clean || current.startsWith(clean + '/');
}
---
<nav class="dig-nav" aria-label={lang === 'ja' ? 'メインナビゲーション' : 'Main navigation'}>
  {items.map((item) => (
    <a href={item.href} data-dig aria-current={isActive(item.href) ? 'page' : undefined}>
      <span class="tile-main">{item.main}</span>
      <span class="tile-sub" lang={other}>{item.sub}</span>
    </a>
  ))}
</nav>
